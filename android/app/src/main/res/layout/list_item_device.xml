<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginTop="20dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    >
    <LinearLayout
        android:id="@+id/deviceItem"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/rounded_status_background"
        android:backgroundTint="@color/dark_blue_200"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="3"
            android:layout_marginLeft="20dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/deviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Device Name"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:gravity="start|center_vertical"
                android:fontFamily="@font/poppins_regular"
                android:textAllCaps="false"
                >
            </TextView>

            <LinearLayout
                android:id="@+id/connectedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">
                <ImageView
                    android:id="@+id/bluetoothStatus"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="@color/status_connected"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_status_connected_24dp"
                    app:layout_constraintTop_toTopOf="@+id/btnBluetooth"
                    app:layout_constraintEnd_toEndOf="@+id/btnBluetooth" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="Connected"
                    android:textSize="16sp"
                    android:textColor="@color/status_connected"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="2"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Disconnect"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:textAllCaps="false"
                android:drawableTint="@color/white"
                app:cornerRadius="12dp">
            </com.google.android.material.button.MaterialButton>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressConnect"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerInParent="true"
                android:visibility="gone"
                android:indeterminate="true"
                android:elevation="8dp"
                app:indicatorColor="@color/white"
                app:trackThickness="5dp"
                app:indicatorSize="24dp" />

        </RelativeLayout>

    </LinearLayout>


</LinearLayout>