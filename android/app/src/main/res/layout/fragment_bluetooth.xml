<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_blue_700"
    android:padding="16dp"
    android:orientation="vertical"
    tools:context=".ui.bluetooth.BluetoothFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_margin="0dp">

        <ImageButton
            android:id="@+id/btnCancel"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@color/dark_blue_700"
            android:src="@drawable/ic_cancel_24dp"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@android:color/white"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:text="Bluetooth Manager"
            android:fontFamily="@font/poppins_regular"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <!--
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:paddingHorizontal="20dp"
            android:layout_height="30dp"
            android:background="@drawable/rounded_status_background"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="Disconnected"
            android:textColor="@color/white"
            android:textSize="16sp" />-->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
    >
        <!--
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="Devices"
            android:fontFamily="@font/poppins_bold"
            android:textSize="25sp"
            android:textColor="@color/white"/> -->

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:layout_marginHorizontal="10dp"
            android:layout_gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                android:layout_height="match_parent"
                android:layout_width="match_parent"
                android:backgroundTint="@color/cyan"
                android:text="Scan"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:textAllCaps="false"
                app:icon="@drawable/ic_bluetooth_searching_24dp"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconSize="40dp"
                app:cornerRadius="20dp"/>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressScan"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerInParent="true"
                android:visibility="gone"
                android:indeterminate="true"
                android:elevation="8dp"
                app:indicatorColor="@color/white"
                app:trackThickness="5dp"
                app:indicatorSize="40dp" />

        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewDevices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/list_item_device"
            android:layout_marginHorizontal="20dp"/>

    </LinearLayout>

</LinearLayout>

