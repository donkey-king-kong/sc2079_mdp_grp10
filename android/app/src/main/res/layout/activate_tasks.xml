<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Task 1 card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/btn_input_field"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TASK 1: TRAVERSE MAP"
                android:textColor="@color/ds_text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.10"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/calculateObstacleTimer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/rounded_status_background"
                android:backgroundTint="@color/ds_bg"
                android:gravity="center"
                android:text="00:00"
                android:textColor="@color/ds_accent"
                android:textSize="22sp"
                android:fontFamily="@font/poppins_bold" />

            <ToggleButton
                android:id="@+id/beginExplorationButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:textOff="TASK 1 START"
                android:textOn="STOP"
                android:textSize="11sp"
                android:textColor="@color/ds_text"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/btn_toggle_task" />
        </LinearLayout>

        <!-- Task 2 card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/btn_input_field"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TASK 2: FASTEST ROUND"
                android:textColor="@color/ds_text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.10"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/fastestTimeTimer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/rounded_status_background"
                android:backgroundTint="@color/ds_bg"
                android:gravity="center"
                android:text="00:00"
                android:textColor="@color/ds_accent"
                android:textSize="22sp"
                android:fontFamily="@font/poppins_bold" />

            <ToggleButton
                android:id="@+id/beginFastestButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:textOff="TASK 2 START"
                android:textOn="STOP"
                android:textSize="11sp"
                android:textColor="@color/ds_text"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/btn_toggle_task" />
        </LinearLayout>

        <!-- Stitch card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/btn_input_field"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RETRIEVE STITCHED IMAGES"
                android:textColor="@color/ds_text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.10"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center" />

            <ToggleButton
                android:id="@+id/beginStichButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:textOff="STITCH START"
                android:textOn="STOP"
                android:textSize="11sp"
                android:textColor="@color/ds_text"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/btn_toggle_stitch" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
