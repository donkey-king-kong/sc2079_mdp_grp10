<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Task 1 card -->
        <LinearLayout
            android:id="@+id/card_task1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_status_background"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/lbl_task1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TASK 1: Traverse Map"
                android:textSize="9sp"
                android:letterSpacing="0.10"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/calculateObstacleTimer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_status_background"
                android:gravity="center"
                android:text="00:00"
                android:textSize="22sp"
                android:fontFamily="@font/poppins_bold" />

            <ToggleButton
                android:id="@+id/beginExplorationButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:textOff="TASK 1 START"
                android:textOn="RESET"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/rounded_status_background" />
        </LinearLayout>

        <!-- Task 2 card -->
        <LinearLayout
            android:id="@+id/card_task2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_status_background"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/lbl_task2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TASK 2: Fastest Round"
                android:textSize="9sp"
                android:letterSpacing="0.10"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/fastestTimeTimer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_status_background"
                android:gravity="center"
                android:text="00:00"
                android:textSize="22sp"
                android:fontFamily="@font/poppins_bold" />

            <ToggleButton
                android:id="@+id/beginFastestButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:textOff="TASK 2 START"
                android:textOn="RESET"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/rounded_status_background" />
        </LinearLayout>

        <!-- Stitch card -->
        <LinearLayout
            android:id="@+id/card_stitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_status_background"
            android:padding="10dp">

            <TextView
                android:id="@+id/lbl_stitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RETRIEVE STITCHED IMAGES"
                android:textSize="9sp"
                android:letterSpacing="0.10"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center" />

            <ToggleButton
                android:id="@+id/beginStichButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:textOff="STITCH START"
                android:textOn="STOP"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/rounded_status_background" />

            <Button
                android:id="@+id/viewSavedImagesButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:text="VIEW SAVED IMAGES"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_bold"
                android:background="@drawable/rounded_status_background" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
