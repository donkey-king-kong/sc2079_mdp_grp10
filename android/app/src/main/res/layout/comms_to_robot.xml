<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/relativeLayout_commsRobot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rounded_status_background"
        android:backgroundTint="@color/dark_blue_700"
        tools:layout_editor_absoluteX="169dp"
        tools:layout_editor_absoluteY="410dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/rounded_status_background"
            android:backgroundTint="@color/dark_blue_700"
            android:padding="10dp">

            <TextView
                android:id="@+id/messageBlock"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:padding="10dp"
                android:gravity="bottom"
                android:paddingStart="20dp"
                android:paddingEnd="5dp"
                android:scrollbars="vertical"
                android:textSize="30sp"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins_regular"
                android:background="@drawable/rounded_background"
                android:backgroundTint="@color/dark_blue_200"
                android:isScrollContainer="true"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/typeBoxEditText"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:gravity="center|start"
                    android:hint="Type something..."
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:paddingStart="20dp"
                    android:layout_marginEnd="10dp"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="@color/dark_blue_200"
                    />
                <ImageButton
                    android:id="@+id/messageButton"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:foregroundGravity="center"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/send_message"
                    android:backgroundTint="@color/magenta"
                    android:background="@drawable/rounded_background"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>