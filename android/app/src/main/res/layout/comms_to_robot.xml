<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_panel"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MESSAGE LOG"
            android:textColor="@color/ds_text"
            android:textSize="11sp"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="0.12" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/clearLogButton"
            android:stateListAnimator="@null"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Clear"
            android:textSize="10sp"
            android:textColor="@color/ds_red"
            android:background="@drawable/btn_cancel"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- Message log -->
    <TextView
        android:id="@+id/messageBlock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"
        android:gravity="bottom"
        android:scrollbars="vertical"
        android:textSize="11sp"
        android:textColor="@color/ds_text"
        android:fontFamily="@font/poppins_regular"
        android:background="@drawable/btn_input_field"
        android:isScrollContainer="true"
        android:layout_marginBottom="8dp" />

    <!-- Input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/btn_input_field"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/typeBoxEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message…"
            android:textColor="@color/ds_text"
            android:textColorHint="@color/ds_text_dim"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular"
            android:background="@null"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/messageButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/send_message"
            android:background="@drawable/btn_mode_selected"
            app:tint="@color/white"
            android:contentDescription="Send" />

    </LinearLayout>

</LinearLayout>
