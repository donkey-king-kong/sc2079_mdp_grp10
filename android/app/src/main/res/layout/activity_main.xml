<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_blue_700">

    <!-- LEFT SIDE: Grid area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintGridMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rightPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.55">

        <!-- Y-axis -->
        <LinearLayout
            android:id="@+id/y_axis_numbers"
            android:layout_width="24dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            app:layout_constraintBottom_toTopOf="@+id/x_axis_numbers"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- X-axis -->
        <LinearLayout
            android:id="@+id/x_axis_numbers"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/y_axis_numbers" />

        <!-- Grid -->
        <LinearLayout
            android:id="@+id/gridMapView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/x_axis_numbers"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/y_axis_numbers"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="1:1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RIGHT SIDE PANEL -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/constraintGridMapView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.45">

        <!-- Top bar: status + buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <!-- Coordinates -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="6dp"
                android:background="@drawable/rounded_status_background"
                android:backgroundTint="@color/dark_blue_200"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Coordinates"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_bold" />

                <TextView
                    android:id="@+id/give_vehicle_coord_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="(x,y)"
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/give_vehicle_direction_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="EMPTY"
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>

            <!-- Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="6dp"
                android:background="@drawable/rounded_status_background"
                android:backgroundTint="@color/dark_blue_200"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Status"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_bold" />

                <TextView
                    android:id="@+id/give_vehicle_status_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Inactive"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnAddCoordinate"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/button_rounded_square_background"
                    android:backgroundTint="@color/cyan"
                    android:contentDescription="Add Coordinate"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/plus_for_enter"
                    android:layout_marginEnd="6dp"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnCoordinates"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/button_rounded_square_background"
                    android:backgroundTint="@color/cyan"
                    android:contentDescription="Coordinates"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dashboard_black_24dp"
                    android:layout_marginEnd="6dp"
                    app:tint="@android:color/white" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageButton
                        android:id="@+id/btnBluetooth"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/button_rounded_square_background"
                        android:backgroundTint="@color/cyan"
                        android:contentDescription="Bluetooth"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_bluetooth_24dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@android:color/white" />

                    <ImageView
                        android:id="@+id/bluetoothStatus"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="@color/status_disconnected"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_status_disconnected_24dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="28dp"
                        android:layout_marginEnd="-4dp" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Middle: Joystick + Tabs side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Joystick column -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="6dp">

                <io.github.controlwear.virtual.joystick.android.JoystickView
                    android:id="@+id/joystickView"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:JV_backgroundColor="@color/cyan"
                    app:JV_borderColor="@color/white"
                    app:JV_borderWidth="4dp"
                    app:JV_buttonColor="@color/magenta"
                    app:JV_buttonSizeRatio="15%"
                    app:JV_fixedCenter="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="6dp">

                    <ImageButton
                        android:id="@+id/reverse_left_button"
                        android:layout_width="60dp"
                        android:layout_height="36dp"
                        android:background="@drawable/button_rounded_square_background"
                        android:src="@drawable/reverse_left_button"
                        android:layout_marginEnd="6dp"
                        app:tint="@android:color/white" />

                    <ImageButton
                        android:id="@+id/reverse_right_button"
                        android:layout_width="60dp"
                        android:layout_height="36dp"
                        android:background="@drawable/button_rounded_square_background"
                        android:backgroundTint="@color/magenta"
                        android:src="@drawable/reverse_right_button"
                        app:tint="@android:color/white" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tabs column -->
            <LinearLayout
                android:id="@+id/sub_navigation_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tabMode="fixed"
                    app:tabGravity="fill" />

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/sub_navigation_bar"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom: action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_map_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Reset"
                android:textSize="11sp"
                android:textColor="@color/white"
                app:icon="@drawable/restart_icon"
                app:iconGravity="textEnd"
                app:iconSize="20dp"
                app:iconTint="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_map_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Save"
                android:textSize="11sp"
                android:textColor="@color/white"
                app:icon="@drawable/save_map_icon"
                app:iconGravity="textEnd"
                app:iconSize="20dp"
                app:iconTint="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/load_map_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Load"
                android:textSize="11sp"
                android:textColor="@color/white"
                app:icon="@drawable/save_map_icon"
                app:iconGravity="textEnd"
                app:iconSize="20dp"
                app:iconTint="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_logs_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Clear Logs"
                android:textSize="11sp"
                android:textColor="@color/white"
                app:icon="@drawable/outline_delete_24dp"
                app:iconGravity="textEnd"
                app:iconSize="20dp"
                app:iconTint="@android:color/white" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
