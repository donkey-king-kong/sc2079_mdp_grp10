<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- HEADER BAR (full width) -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_panel"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <!-- POSITION label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POSITION"
            android:textSize="9sp"
            android:letterSpacing="0.12"
            android:textColor="@color/ds_text_muted"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginEnd="6dp" />

        <!-- Position pill -->
        <LinearLayout
            android:id="@+id/coordCard"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_status_background"
            android:backgroundTint="@color/ds_surface"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/give_vehicle_coord_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—, —"
                android:textSize="12sp"
                android:textColor="@color/ds_text"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:id="@+id/give_vehicle_direction_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="@color/ds_text_muted"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/ds_border_strong"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp" />

        <!-- Status dot -->
        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="@color/status_disconnected"
            android:layout_marginEnd="6dp" />

        <!-- Status text -->
        <TextView
            android:id="@+id/give_vehicle_status_now"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vehicle not placed"
            android:textSize="11sp"
            android:textColor="@color/ds_text_muted"
            android:fontFamily="@font/poppins_regular"
            android:singleLine="true" />

        <!-- Theme toggle -->
        <Button
            android:id="@+id/btnThemeToggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="☀"
            android:textSize="14sp"
            android:textColor="#990C0E11"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_header_icon"
            android:stateListAnimator="@null" />

        <!-- Bluetooth button + status dot -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp">

            <ImageButton
                android:id="@+id/btnBluetooth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/btn_header_icon"
                android:contentDescription="Bluetooth"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bluetooth_24dp"
                app:tint="#990C0E11" />

            <ImageView
                android:id="@+id/bluetoothStatus"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/status_disconnected"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_status_disconnected_24dp" />
        </FrameLayout>

    </LinearLayout>

    <!-- BODY: two columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT: Grid + footer -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Grid area -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintGridMapView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/y_axis_numbers"
                    android:layout_width="20dp"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/gridMapView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/gridMapView" />

                <LinearLayout
                    android:id="@+id/x_axis_numbers"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/gridMapView"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/gridMapView"
                    app:layout_constraintStart_toStartOf="@id/gridMapView" />

                <LinearLayout
                    android:id="@+id/gridMapView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintBottom_toTopOf="@id/x_axis_numbers"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/y_axis_numbers"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintDimensionRatio="1:1" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- GRID FOOTER BAR -->
            <LinearLayout
                android:id="@+id/bottomRow"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/bg_panel"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <!-- Grid size label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grid size"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginEnd="6dp" />

                <!-- − button (wired to showGridSizeDialog in code) -->
                <Button
                    android:id="@+id/btn_grid_size"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="−"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0C0E11"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/btn_footer"
                    android:stateListAnimator="@null" />

                <TextView
                    android:id="@+id/grid_size_label"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="20"
                    android:textSize="13sp"
                    android:textColor="@color/ds_text"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Reset -->
                <Button
                    android:id="@+id/reset_map_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Reset"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8C0C0E11"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/btn_footer"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="6dp" />

                <!-- Save -->
                <Button
                    android:id="@+id/save_map_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Save"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8C0C0E11"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/btn_footer"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="6dp" />

                <!-- Load -->
                <Button
                    android:id="@+id/load_map_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Load"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8C0C0E11"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/btn_footer"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </LinearLayout>

        <!-- RIGHT PANEL -->
        <LinearLayout
            android:id="@+id/rightPanel"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_panel">

            <!-- Tab bar + pager — flex height, fills between header and d-pad -->
            <LinearLayout
                android:id="@+id/sub_navigation_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@color/bg_surface"
                    app:tabMode="fixed"
                    app:tabGravity="fill"
                    app:tabMinWidth="0dp"
                    app:tabPaddingStart="0dp"
                    app:tabPaddingEnd="0dp"
                    app:tabSelectedTextColor="@color/accent"
                    app:tabTextColor="@color/text_dim"
                    app:tabIndicatorColor="@color/accent"
                    app:tabIndicatorHeight="2dp" />

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/sub_navigation_bar"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/bg_panel" />

            </LinearLayout>

            <!-- D-pad section — fixed at bottom of right panel -->
            <LinearLayout
                android:id="@+id/dpadSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="12dp"
                android:background="@color/bg_panel">

                <!-- 1dp top border -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_strong"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/dpad_up"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="▲"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/btn_dpad"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/dpad_left"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="◀"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/btn_dpad"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null"
                        android:layout_marginEnd="4dp" />

                    <View
                        android:id="@+id/dpadCenterSquare"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/btn_dpad" />

                    <Button
                        android:id="@+id/dpad_right"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="▶"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/btn_dpad"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/dpad_down"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="▼"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/btn_dpad"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="6dp" />

                <!-- Rev buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:id="@+id/reverse_left_button"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/btn_dpad_rev"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginEnd="4dp">

                        <ImageView
                            android:id="@+id/revLeftIcon"
                            android:layout_width="20dp"
                            android:layout_height="14dp"
                            android:src="@drawable/reverse_left_button"
                            android:scaleType="fitCenter"
                            app:tint="@color/text_primary" />

                        <TextView
                            android:id="@+id/revLeftLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rev ◀"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/reverse_right_button"
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/btn_dpad_rev"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:id="@+id/revRightIcon"
                            android:layout_width="20dp"
                            android:layout_height="14dp"
                            android:src="@drawable/reverse_right_button"
                            android:scaleType="fitCenter"
                            app:tint="@color/text_primary" />

                        <TextView
                            android:id="@+id/revRightLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rev ▶"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/poppins_bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Hidden buttons kept for logic wiring -->
            <ImageButton
                android:id="@+id/btnAddCoordinate"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="Place obstacle or vehicle"
                android:src="@drawable/plus_for_enter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_logs_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="Clear" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
