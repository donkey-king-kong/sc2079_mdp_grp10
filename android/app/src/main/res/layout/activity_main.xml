<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/dark_blue_700">

    <!-- LEFT: Grid area (square, weight-based) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintGridMapView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="8dp">

        <!-- Y-axis -->
        <LinearLayout
            android:id="@+id/y_axis_numbers"
            android:layout_width="24dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            app:layout_constraintBottom_toTopOf="@+id/x_axis_numbers"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- X-axis -->
        <LinearLayout
            android:id="@+id/x_axis_numbers"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/y_axis_numbers" />

        <!-- Grid (square ratio) -->
        <LinearLayout
            android:id="@+id/gridMapView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/x_axis_numbers"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/y_axis_numbers"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="1:1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RIGHT: Control panel (fixed weight) -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Row 1: Status cards + action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <!-- Coordinates card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="6dp"
                android:background="@drawable/rounded_status_background"
                android:backgroundTint="@color/dark_blue_200"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Coordinates"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_bold" />

                <TextView
                    android:id="@+id/give_vehicle_coord_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="(x,y)"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/give_vehicle_direction_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="EMPTY"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>

            <!-- Status card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="6dp"
                android:background="@drawable/rounded_status_background"
                android:backgroundTint="@color/dark_blue_200"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Status"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_bold" />

                <TextView
                    android:id="@+id/give_vehicle_status_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Inactive"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>

            <!-- Icon buttons -->
            <ImageButton
                android:id="@+id/btnAddCoordinate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/button_rounded_square_background"
                android:backgroundTint="@color/cyan"
                android:contentDescription="Add Coordinate"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/plus_for_enter"
                android:layout_marginEnd="4dp"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnCoordinates"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/button_rounded_square_background"
                android:backgroundTint="@color/cyan"
                android:contentDescription="Coordinates"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_dashboard_black_24dp"
                android:layout_marginEnd="4dp"
                app:tint="@android:color/white" />

            <!-- Bluetooth button + status indicator -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageButton
                    android:id="@+id/btnBluetooth"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/button_rounded_square_background"
                    android:backgroundTint="@color/cyan"
                    android:contentDescription="Bluetooth"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bluetooth_24dp"
                    app:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/bluetoothStatus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="end|bottom"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="@color/status_disconnected"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_status_disconnected_24dp" />
            </FrameLayout>

        </LinearLayout>

        <!-- Row 2: Joystick + Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Joystick + reverse buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="6dp">

                <io.github.controlwear.virtual.joystick.android.JoystickView
                    android:id="@+id/joystickView"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    app:JV_backgroundColor="@color/cyan"
                    app:JV_borderColor="@color/white"
                    app:JV_borderWidth="4dp"
                    app:JV_buttonColor="@color/magenta"
                    app:JV_buttonSizeRatio="15%"
                    app:JV_fixedCenter="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp">

                    <ImageButton
                        android:id="@+id/reverse_left_button"
                        android:layout_width="55dp"
                        android:layout_height="34dp"
                        android:background="@drawable/button_rounded_square_background"
                        android:src="@drawable/reverse_left_button"
                        android:layout_marginEnd="4dp"
                        app:tint="@android:color/white" />

                    <ImageButton
                        android:id="@+id/reverse_right_button"
                        android:layout_width="55dp"
                        android:layout_height="34dp"
                        android:background="@drawable/button_rounded_square_background"
                        android:backgroundTint="@color/magenta"
                        android:src="@drawable/reverse_right_button"
                        app:tint="@android:color/white" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tabs -->
            <LinearLayout
                android:id="@+id/sub_navigation_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tabMode="scrollable"
                    app:tabGravity="center" />

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/sub_navigation_bar"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

        </LinearLayout>

        <!-- Row 3: Bottom buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manual_update_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Manual"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auto_update_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Auto"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_map_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Reset"
                android:textSize="9sp"
                android:textColor="@color/white"
                android:singleLine="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_map_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Save"
                android:textSize="9sp"
                android:textColor="@color/white"
                android:singleLine="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/load_map_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Load"
                android:textSize="9sp"
                android:textColor="@color/white"
                android:singleLine="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_logs_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Clear"
                android:textSize="9sp"
                android:textColor="@color/white"
                android:singleLine="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:iconPadding="0dp" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
