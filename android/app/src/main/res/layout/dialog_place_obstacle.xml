<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Page 1: Coordinate Selection -->
        <LinearLayout
            android:id="@+id/layout_coord_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Place Obstacle"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_x_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Row (X): 0"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"/>

            <GridLayout
                android:id="@+id/grid_x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="10"
                android:rowCount="2"
                android:layout_marginBottom="16dp">
                <!-- Buttons 0-19 will be added programmatically or I can add them here -->
            </GridLayout>

            <TextView
                android:id="@+id/tv_y_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Col (Y): 0"
                android:textColor="@color/black"
                android:layout_marginBottom="4dp"/>

            <GridLayout
                android:id="@+id/grid_y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="10"
                android:rowCount="2"
                android:layout_marginBottom="16dp">
                <!-- Buttons 0-19 will be added programmatically -->
            </GridLayout>

            <TextView
                android:id="@+id/tv_coord_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="(0, 0)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_cancel_coord"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:layout_marginEnd="16dp"/>

                <Button
                    android:id="@+id/btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next"
                    android:backgroundTint="#4C88E9"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Page 2: Direction Selection -->
        <LinearLayout
            android:id="@+id/layout_direction_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_direction_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Add Obstacle at (0, 0)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Tap a direction for the target face"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btn_north"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="↑ N"
                    android:padding="0dp"
                    android:backgroundTint="#F2F2F2"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Button
                    android:id="@+id/btn_west"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="← W"
                    android:padding="0dp"
                    android:backgroundTint="#F2F2F2"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <Button
                    android:id="@+id/btn_go"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="GO"
                    android:textStyle="bold"
                    android:backgroundTint="#D69F3E"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Button
                    android:id="@+id/btn_east"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="→ E"
                    android:padding="0dp"
                    android:backgroundTint="#F2F2F2"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <Button
                    android:id="@+id/btn_south"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="↓ S"
                    android:padding="0dp"
                    android:backgroundTint="#F2F2F2"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/btn_cancel_dir"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Cancel" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
