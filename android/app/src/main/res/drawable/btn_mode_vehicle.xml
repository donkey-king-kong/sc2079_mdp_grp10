<?xml version="1.0" encoding="utf-8"?>
<!-- Vehicle mode button: accent-tinted when activated, white when inactive -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A3ECF" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#731A3ECF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#47000000" />
        </shape>
    </item>
</selector>
