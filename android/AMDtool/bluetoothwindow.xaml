<Window x:Class="AMDtool.BluetoothWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Name="BtWindow" Title="Connect to Bluetooth device" Height="600" Width="400" MinWidth="350"
        MinHeight="250">
  <Grid Background="White">
    <Grid Margin="0,10,0,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Label Grid.Row="0" FontSize="14" Margin="10,0,0,5">DEVICES</Label>
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
        <Image Name="ScanningImage" Source="Resources/icons/wifi.GIF" Opacity="0" Height="15"
               Margin="0,0,0,5"/>
        <Label Name="ScanningLabel" FontSize="14" Margin="0,0,10,5" VerticalContentAlignment="Center" Opacity="0">Scanning...</Label>
      </StackPanel>
      <ListBox Name="DevicesListView" Grid.Row="1"/>
      <TextBlock Name="ErrorLabel" Grid.Row="1" Margin="10,0,10,5" FontSize="12"
                 Foreground="{StaticResource MediumDarkColour}" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
      <Button Name="DiscoverBtBtn" Style="{StaticResource RaisedColouredButtonStyle}" Width="105" Grid.Row="2"
              HorizontalAlignment="Left" Margin="15,10,0,0" Height="36">SCAN</Button>
      <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,15,15,5" HorizontalAlignment="Right">
        <Button Name="BtOkBtn" Margin="10,0,0,0" Width="70" HorizontalAlignment="Right"
                Style="{StaticResource FlatButtonStyle}" Height="36">OK</Button>
        <Button Name="BtCancelBtn" Margin="10,0,0,0" Width="70" HorizontalAlignment="Right"
                Style="{StaticResource FlatButtonStyle}" Height="36">CANCEL</Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>