<Page x:Class="AMDtool.QuickInputPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:AMDtool"
      Title="QuickInputPage">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <ListBox Name="customList" Grid.Column="0" Grid.RowSpan="2" Width="120" HorizontalContentAlignment="Center"
             BorderThickness="0,1,1,1">
      <ListBoxItem>Custom 1</ListBoxItem>
      <ListBoxItem>Custom 2</ListBoxItem>
      <ListBoxItem>Custom 3</ListBoxItem>
      <ListBoxItem>Custom 4</ListBoxItem>
      <ListBoxItem>Custom 5</ListBoxItem>
      <ListBoxItem>Custom 6</ListBoxItem>
      <ListBoxItem>Custom 7</ListBoxItem>
      <ListBoxItem>Custom 8</ListBoxItem>
      <ListBoxItem>Custom 9</ListBoxItem>
    </ListBox>
    <StackPanel Grid.Row="0" Grid.Column="1" Margin="15,15,15,0">
      <Label FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14" Margin="0,0,0,0">Button label</Label>
      <TextBox Name="LabelTb" Style="{StaticResource MultiLineTextBox}" HorizontalContentAlignment="Center"
               Margin="0,0,0,5" FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14"/>
      <Label FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14" Margin="0,10,0,0">Text to send</Label>
    </StackPanel>
    <Border Grid.Column="1" Grid.Row="1" BorderBrush="#ddd" BorderThickness="1,1,1,0"
            SnapsToDevicePixels="true" Margin="15,5,15,0">
      <TextBox Name="SendTb" Style="{StaticResource MultiLineTextBox}"
               FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14" Height="Auto"/>
    </Border>
  </Grid>
</Page>