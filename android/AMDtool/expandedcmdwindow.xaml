<Window x:Class="AMDtool.ExpandedCmdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Log" Height="600" Width="800" Style="{StaticResource {x:Type Window}}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Label Foreground="DimGray" Margin="10,5,5,5" FontSize="14">COMMAND LOG</Label>
    <Border Grid.Row="1" BorderThickness="1,1,1,0" BorderBrush="#f0f0f0" Margin="10,0,10,10"
            Background="Transparent">
      <Border BorderThickness="0,0,0,2" BorderBrush="#d9d9d9">
        <ScrollViewer Name="sv">
          <TextBlock Name="CmdTextBlock" Margin="5,5,5,0" FontSize="14" FontFamily="Consolas" Foreground="Black"/>
        </ScrollViewer>
      </Border>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0"
                Margin="0,0,5,5">
      <Button Name="SaveCmdBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
              VerticalAlignment="Center" ToolTip="Save to file">
        <Image Source="Resources/icons/save_blk.png"/>
      </Button>
      <Button Name="CopyCmdBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
              VerticalAlignment="Center" ToolTip="Copy">
        <Image Source="Resources/icons/copy.png" SnapsToDevicePixels="true"/>
      </Button>
      <Button Name="ClearCmdBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
              VerticalAlignment="Center" ToolTip="Clear">
        <Image Source="Resources/icons/bin.png" SnapsToDevicePixels="true"/>
      </Button>
    </StackPanel>
  </Grid>
</Window>