<Page x:Class="AMDtool.RobotStatOptionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:p="clr-namespace:AMDtool.Properties"
      xmlns:local="clr-namespace:AMDtool"
      Title="RobotStatOptionPage">
  <Grid Margin="15">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14" TextWrapping="Wrap"
               Margin="0,5,0,15" Grid.ColumnSpan="4">
      Customize the status commands and select the status messages to be included to send.
    </TextBlock>
    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center" FontSize="14">
      Number of messages to send
    </TextBlock>
    <TextBox Name="numTb" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Padding="5" Margin="10"
             HorizontalContentAlignment="Center" FontSize="14" Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msgNum, Mode=OneWay}"/>
    <CheckBox Name="box1" Grid.Column="0" Grid.Row="2" Margin="10" VerticalAlignment="Center"/>
    <CheckBox Name="box2" Grid.Column="0" Grid.Row="3" Margin="10" VerticalAlignment="Center"/>
    <CheckBox Name="box3" Grid.Column="0" Grid.Row="4" Margin="10" VerticalAlignment="Center"/>
    <CheckBox Name="box4" Grid.Column="0" Grid.Row="5" Margin="10" VerticalAlignment="Center"/>
    <CheckBox Name="box5" Grid.Column="0" Grid.Row="6" Margin="10" VerticalAlignment="Center"/>
    <CheckBox Name="box6" Grid.Column="2" Grid.Row="2" Margin="10" VerticalAlignment="Center"/>
    <CheckBox Name="box7" Grid.Column="2" Grid.Row="3" Margin="10" VerticalAlignment="Center"/>
    <CheckBox Name="box8" Grid.Column="2" Grid.Row="4" Margin="10" VerticalAlignment="Center"/>
    <CheckBox Name="box9" Grid.Column="2" Grid.Row="5" Margin="10" VerticalAlignment="Center"/>
    <CheckBox Name="box10" Grid.Column="2" Grid.Row="6" Margin="10" VerticalAlignment="Center"/>
    <TextBox Name="tb1" Grid.Column="1" Grid.Row="2" Padding="5" Margin="10"
             Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msg1, Mode=OneWay}"/>
    <TextBox Name="tb2" Grid.Column="1" Grid.Row="3" Padding="5" Margin="10"
             Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msg2, Mode=OneWay}"/>
    <TextBox Name="tb3" Grid.Column="1" Grid.Row="4" Padding="5" Margin="10"
             Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msg3, Mode=OneWay}"/>
    <TextBox Name="tb4" Grid.Column="1" Grid.Row="5" Padding="5" Margin="10"
             Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msg4, Mode=OneWay}"/>
    <TextBox Name="tb5" Grid.Column="1" Grid.Row="6" Padding="5" Margin="10"
             Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msg5, Mode=OneWay}"/>
    <TextBox Name="tb6" Grid.Column="3" Grid.Row="2" Padding="5" Margin="10"
             Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msg6, Mode=OneWay}"/>
    <TextBox Name="tb7" Grid.Column="3" Grid.Row="3" Padding="5" Margin="10"
             Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msg7, Mode=OneWay}"/>
    <TextBox Name="tb8" Grid.Column="3" Grid.Row="4" Padding="5" Margin="10"
             Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msg8, Mode=OneWay}"/>
    <TextBox Name="tb9" Grid.Column="3" Grid.Row="5" Padding="5" Margin="10"
             Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msg9, Mode=OneWay}"/>
    <TextBox Name="tb10" Grid.Column="3" Grid.Row="6" Padding="5" Margin="10"
             Style="{StaticResource MultiLineTextBox}"
             Text="{Binding Source={x:Static p:Settings.Default}, Path=msg10, Mode=OneWay}"/>
  </Grid>
</Page>