<Window x:Class="AMDtool.RemovedPairedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove Paired Bluetooth Devices" Height="600" Width="400" MinWidth="350" MinHeight="250">
  <Grid Background="White">
    <Grid Margin="0,10,0,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Label Grid.Row="0" FontSize="14" Margin="10,0,0,5">PAIRED DEVICES</Label>
      <ListBox Name="DevicesList" Grid.Row="1" SelectionMode="Multiple"/>
      <Button Name="RemoveBtn" Style="{StaticResource RaisedColouredButtonStyle}" Width="105" Grid.Row="2"
              HorizontalAlignment="Left" Margin="15,10,0,0" Height="36">REMOVE</Button>
      <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,15,15,5" HorizontalAlignment="Right">
        <Button Name="SelectAllBtn" Margin="10,0,0,0" Width="95" HorizontalAlignment="Right"
                Style="{StaticResource FlatButtonStyle}" Height="36">SELECT ALL</Button>
        <Button Name="CloseBtn" Margin="10,0,0,0" Width="70" HorizontalAlignment="Right"
                Style="{StaticResource FlatButtonStyle}" Height="36">CLOSE</Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>