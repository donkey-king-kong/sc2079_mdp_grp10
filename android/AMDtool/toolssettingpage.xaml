<Page x:Class="AMDtool.ToolsSettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:AMDtool"
      Title="Default arena and robot size">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <TextBlock TextWrapping="Wrap" FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14"
               Margin="0,5,0,30" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2">
      Modify the default size of the arena and robot when software starts.
    </TextBlock>
    <Label FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14" Margin="0,0,0,0"
           Grid.Column="0" Grid.Row="1">Robot size (grids)</Label>
    <TextBox Name="sizeTb" Style="{StaticResource MultiLineTextBox}" Margin="0,0,0,5" Grid.Row="1"
             Grid.Column="1" HorizontalContentAlignment="Center"
             FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14"
             VerticalContentAlignment="Bottom"/>
    <Label FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14" Margin="0,20,20,0"
           Grid.Column="0" Grid.Row="2">
      Robot direction (degrees)
    </Label>
    <TextBox Name="angleTb" Style="{StaticResource MultiLineTextBox}" Margin="0,0,0,5" Grid.Row="2"
             Grid.Column="1" HorizontalContentAlignment="Center"
             FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14"
             VerticalContentAlignment="Bottom"/>
    <Label FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14" Margin="0,20,0,0"
           Grid.Column="0" Grid.Row="3">Arena width (grids)</Label>
    <TextBox Name="WTb" Style="{StaticResource MultiLineTextBox}" Margin="0,0,0,5" Grid.Row="3" Grid.Column="1"
             HorizontalContentAlignment="Center" FontFamily="/AMDtool;component/Resources/fonts/#Roboto"
             FontSize="14" VerticalContentAlignment="Bottom"/>
    <Label FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14" Margin="0,20,20,0"
           Grid.Column="0" Grid.Row="4">
      Arena height (grids)
    </Label>
    <TextBox Name="HTb" Style="{StaticResource MultiLineTextBox}" Margin="0,0,0,5" Grid.Row="4" Grid.Column="1"
             HorizontalContentAlignment="Center" FontFamily="/AMDtool;component/Resources/fonts/#Roboto"
             FontSize="14" VerticalContentAlignment="Bottom"/>
  </Grid>
</Page>