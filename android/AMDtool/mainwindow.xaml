<Window x:Class="AMDtool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android Module Tool" Height="768" Width="1024">
  <Grid Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Menu IsMainMenu="true" VerticalAlignment="Top" Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Name="SaveItem" Header="_Save Arena">
          <MenuItem.Icon>
            <Image Source="Resources/icons/save_blk.png" Height="15"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="LoadFileItem" Header="Load Arena">
          <MenuItem.Icon>
            <Image Source="Resources/icons/load_blk.png" Height="15"/>
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Settings">
        <MenuItem Name="SettingsItem" Header="Customize">
          <MenuItem.Icon>
            <Image Source="Resources/icons/settings_blk.png" Height="15"/>
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Bluetooth">
        <MenuItem Name="ScanBtItem" Header="Scan For Devices">
          <MenuItem.Icon>
            <Image Source="Resources/icons/wifi_blk.png" Width="18"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="RemovePairedItem" Header="Remove Paired Device"/>
        <MenuItem Name="DisconnectItem" Header="Disconnect">
          <MenuItem.Icon>
            <Image Source="Resources/icons/disconnect.png" Width="18"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Name="ReconnectBtItem" Header="Reconnect to last device"/>
      </MenuItem>
      <MenuItem Name="AboutItem" Header="_About"/>
    </Menu>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Grid Column="0" Background="#FFFFFF">
        <Grid Background="{StaticResource MediumColour}" Height="52" VerticalAlignment="Top"
              Effect="{StaticResource ShadowEffect}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Name="ArenaButton" Style="{StaticResource ArenaToolButtonStyle}">
              <Image Source="Resources/icons/btn_arena.png" Height="20" SnapsToDevicePixels="true"/>
            </Button>
            <Rectangle Fill="#66FFFFFF" Width="1" Margin="0,5,0,5" SnapsToDevicePixels="true"/>
            <Button Name="AddObstacleButton" Style="{StaticResource ArenaToolButtonStyle}">
              <Image Source="Resources/icons/btn_obstacle.png" Height="25" ToolTip="Place obstacle"/>
            </Button>
            <Button Name="RemoveObstacleButton" Style="{StaticResource ArenaToolButtonStyle}">
              <Image Source="Resources/icons/btn_obstacleremove.png" Height="25" ToolTip="Remove obstacle"/>
            </Button>
            <Rectangle Fill="#66FFFFFF" Width="1" Margin="0,5,0,5" SnapsToDevicePixels="true"/>
            <Button Name="AddRobotButton" Style="{StaticResource ArenaToolButtonStyle}" Margin="5,5,0,5" Padding="3">
              <Image Source="Resources/icons/btn_robot.png" Height="25" ToolTip="Place robot"/>
            </Button>
            <Button Name="RobotSizeButton" Style="{StaticResource ArenaToolButtonStyle}" Margin="0,5,5,5" Padding="3">
              <Image Source="Resources/icons/drop.png" Height="4" Margin="0"/>
            </Button>
            <Button Name="RotateLeftButton" Style="{StaticResource ArenaToolButtonStyle}">
              <Image Source="Resources/icons/btn_rotateleft.png" Height="20" ToolTip="Rotate left to next 90º interval"/>
            </Button>
            <Button Name="RotateRightButton" Style="{StaticResource ArenaToolButtonStyle}">
              <Image Source="Resources/icons/btn_rotateleft.png" Height="20" ToolTip="Rotate right to next 90º interval"
                     RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                  </TransformGroup>
                </UIElement.RenderTransform>
              </Image>
            </Button>
            <Image Source="Resources/icons/angle.png" Height="14" Margin="5,5,0,0"/>
            <TextBox Name="DirectionTextBox" Width="27" Height="20" MaxLength="3" Foreground="White" Margin="5,5,0,5"
                     FontSize="10" ToolTip="Robot orientation starting from North clockwise">0</TextBox>
            <Label Foreground="White" Margin="0,5,5,5">º</Label>
          </StackPanel>
        </Grid>
        <Viewbox Name="ArenaMapHolder" Margin="10,65,10,10" SnapsToDevicePixels="true" HorizontalAlignment="Left"
                 VerticalAlignment="Top">
          <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource UltraLightColour}">
            <Grid Name="ArenaGrid" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Grid Name="RobotHolder" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </Grid>
        </Viewbox>
      </Grid>
      <Grid Column="1" Background="{StaticResource GreyBackground}" Effect="{StaticResource ShadowEffect2}">
        <Grid Background="Transparent" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Resources/icons/bluetooth_blk.png" Height="13" Margin="10,0,0,0"/>
            <Grid>
              <Label Name="BtLabel1" Foreground="#ababab" FontFamily="/AMDtool;component/Resources/fonts/#Roboto"
                     Margin="0,0,0,0" FontSize="10" Opacity="1">NOT CONNECTED</Label>
              <Label Name="BtLabel2" Foreground="#ababab" FontFamily="/AMDtool;component/Resources/fonts/#Roboto"
                     Margin="0,0,0,0" FontSize="10" Opacity="0"/>
            </Grid>
          </StackPanel>
        </Grid>
        <Grid Margin="0,25,3,0">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRightGrid"/>
            <RowDefinition x:Name="MidRightGrid"/>
            <RowDefinition x:Name="BotRightGrid"/>
          </Grid.RowDefinitions>
          <Expander Name="SendExpander" Margin="10,0,6,0" VerticalAlignment="Stretch" FontSize="14"
                    Foreground="DimGray" Grid.Row="0" IsExpanded="true" Header="SEND TO REMOTE">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="White" Margin="0,5,0,0" BorderBrush="WhiteSmoke" BorderThickness="1">
                <TextBox Name="SendTextBox" Margin="0,0,0,0" FontSize="14" FontFamily="Consolas"
                         Style="{StaticResource MultiLineTextBox}"/>
              </Border>
              <Grid Margin="0,10,0,13" VerticalAlignment="Bottom" Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*"/>
                  <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button Name="ClearBtn" Margin="0,0,5,0" Grid.Column="0" FontSize="16">CLEAR</Button>
                <Button Name="SendBtn" Margin="5,0,0,0" Grid.Column="1" FontSize="16"
                        Style="{StaticResource RaisedColouredButtonStyle}">SEND</Button>
              </Grid>
            </Grid>
          </Expander>
          <Button Name="SendMoreBtn" Margin="0,0,10,0" HorizontalAlignment="Right" Height="15" Width="20"
                  ToolTip="Open Advanced Send" Style="{StaticResource ImageBtnStyle}" Grid.Row="0"
                  VerticalAlignment="Top" HorizontalContentAlignment="Right">
            <Image Source="Resources/icons/more.png" Height="15" SnapsToDevicePixels="true"
                   HorizontalAlignment="Right"/>
          </Button>
          <Button Name="SendGridBtn" Margin="0,-3,35,0" HorizontalAlignment="Right" Height="21" Width="21"
                  VerticalContentAlignment="Center" ToolTip="Send the arena information on change"
                  Style="{StaticResource ImageBtnStyle}" Grid.Row="0" VerticalAlignment="Top"
                  HorizontalContentAlignment="Center">
            <Image Source="Resources/icons/sendgrid.png" Height="15" SnapsToDevicePixels="true"
                   HorizontalAlignment="Right"/>
          </Button>
          <Expander Name="ReceivedExpander" Margin="10,5,6,0" Header="RECEIVED TEXT" FontSize="14" Foreground="DimGray"
                    Grid.Row="1" IsExpanded="true">
            <Border BorderThickness="1,1,1,0" BorderBrush="#f0f0f0" Margin="0,5,0,13" Background="WhiteSmoke">
              <Border BorderThickness="0,0,0,2" BorderBrush="#d9d9d9">
                <ScrollViewer Name="ReceivedSV">
                  <TextBlock Name="ReceivedTextBlock" Margin="5,5,5,0" FontSize="14" FontFamily="Consolas" Foreground="Black"/>
                </ScrollViewer>
              </Border>
            </Border>
          </Expander>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="1">
            <Button Name="SaveReceivedBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
                    VerticalAlignment="Center" ToolTip="Save to file">
              <Image Source="Resources/icons/save_blk.png"/>
            </Button>
            <Button Name="CopyReceivedBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
                    VerticalAlignment="Center" ToolTip="Copy">
              <Image Source="Resources/icons/copy.png"/>
            </Button>
            <Button Name="ClearReceivedBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
                    VerticalAlignment="Center" ToolTip="Clear">
              <Image Source="Resources/icons/bin.png"/>
            </Button>
            <Button Name="ExpandReceivedBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
                    VerticalAlignment="Center" ToolTip="Expand">
              <Image Source="Resources/icons/expand.png"/>
            </Button>
          </StackPanel>
          <Expander Name="CommandExpander" Margin="10,5,6,0" Header="COMMAND LOG" FontSize="14" Foreground="DimGray"
                    Grid.Row="2" IsExpanded="true">
            <Border BorderThickness="1,1,1,0" BorderBrush="#f0f0f0" Margin="0,5,0,10" Background="WhiteSmoke">
              <Border BorderThickness="0,0,0,2" BorderBrush="#d9d9d9">
                <ScrollViewer Name="CommandSV">
                  <TextBlock Name="CommandLogTextBlock" Margin="5,5,5,0" FontSize="14" FontFamily="Consolas" Foreground="Black"/>
                </ScrollViewer>
              </Border>
            </Border>
          </Expander>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="2">
            <Button Name="SaveCmdBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
                    VerticalAlignment="Center" ToolTip="Save to file">
              <Image Source="Resources/icons/save_blk.png"/>
            </Button>
            <Button Name="CopyCmdBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
                    VerticalAlignment="Center" ToolTip="Copy">
              <Image Source="Resources/icons/copy.png"/>
            </Button>
            <Button Name="ClearCmdBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
                    VerticalAlignment="Center" ToolTip="Clear">
              <Image Source="Resources/icons/bin.png"/>
            </Button>
            <Button Name="ExpandCmdBtn" Style="{StaticResource ImageBtnStyle}" Height="15" Width="15"
                    VerticalAlignment="Center" ToolTip="Expand">
              <Image Source="Resources/icons/expand.png"/>
            </Button>
          </StackPanel>
          <GridSplitter Name="RightGridSplitter1" Grid.Row="0" Height="5" VerticalAlignment="Bottom" Width="5000"
                        Background="#dbdbdb" ResizeDirection="Rows" BorderThickness="0,2" BorderBrush="Transparent"
                        SnapsToDevicePixels="true"/>
          <GridSplitter Name="RightGridSplitter2" Grid.Row="1" Height="5" VerticalAlignment="Bottom" Width="5000"
                        Background="#dbdbdb" ResizeDirection="Rows" BorderThickness="0,2" BorderBrush="Transparent"
                        SnapsToDevicePixels="true"/>
        </Grid>
      </Grid>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Left" Background="Transparent" Width="4" BorderThickness="4,0"
                    BorderBrush="Transparent"/>
    </Grid>
    <Grid Name="GenerateArenaMenu" Height="140" Width="122" Background="White"
          Effect="{StaticResource ShadowEffect3}" Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"
          Margin="0,52,0,0" IsEnabled="true" Opacity="0" IsHitTestVisible="false">
      <StackPanel Orientation="Vertical" Margin="15">
        <StackPanel Orientation="Horizontal">
          <Label FontSize="14" VerticalAlignment="Top">X:</Label>
          <TextBox Name="XTextBox" Width="50" Height="25" MaxLength="2" Margin="10,0">15</TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Label FontSize="14" VerticalAlignment="Top">Y:</Label>
          <TextBox Name="YTextBox" Width="50" Height="25" MaxLength="2" Margin="10,0">20</TextBox>
        </StackPanel>
        <Button Name="GenerateArenaButton" Style="{StaticResource RaisedColouredButtonStyle}" Margin="5,15,5,0">GENERATE</Button>
      </StackPanel>
    </Grid>
    <Grid Name="RobotSizeDropdownGrid" Width="40" Row="1" Margin="133,45,0,0" Opacity="0"
          IsHitTestVisible="false" VerticalAlignment="Top" HorizontalAlignment="Left" IsEnabled="false">
      <ListBox Name="RobotSizeDropDownListBox" Effect="{StaticResource ShadowEffect3}" BorderThickness="0"
               HorizontalContentAlignment="Center">
        <ListBoxItem Padding="5">1</ListBoxItem>
        <ListBoxItem Padding="5">2</ListBoxItem>
        <ListBoxItem Padding="5" IsSelected="true">3</ListBoxItem>
        <ListBoxItem Padding="5">4</ListBoxItem>
      </ListBox>
    </Grid>
    <StackPanel Grid.Row="1"/>
    <Label Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Foreground="White"
           Grid.Row="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="50"
           Opacity="0" FontSize="14" FontFamily="/AMDtool;component/Resources/fonts/#Roboto"
           SnapsToDevicePixels="true" Background="#aa000000" Effect="{StaticResource ShadowEffect}"
           Padding="20,0,20,0" Margin="0,0,0,15" IsHitTestVisible="false"/>
  </Grid>
</Window>