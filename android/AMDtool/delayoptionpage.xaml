<Page x:Class="AMDtool.DelayOptionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:AMDtool"
      Title="DelayOptionPage">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <TextBlock TextWrapping="Wrap" FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14"
               Margin="15,20,15,30" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2">
      Modifies the delay settings.
    </TextBlock>
    <Label FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14" Margin="15,0,0,0"
           Grid.Column="0" Grid.Row="1">Delay duration (ms)</Label>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="15,0,15,0" Orientation="Vertical">
      <TextBox Name="DurationTb" Style="{StaticResource MultiLineTextBox}" Margin="0,0,0,5"
               HorizontalContentAlignment="Center" FontFamily="/AMDtool;component/Resources/fonts/#Roboto"
               FontSize="14"/>
      <Label FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="12">
        The actual delay is estimated and may not be 100% accurate.
      </Label>
    </StackPanel>
    <Label FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="14" Margin="15,20,0,0"
           Grid.Column="0" Grid.Row="2">
      String to recognize delay
    </Label>
    <StackPanel Grid.Row="2" Grid.Column="1" Margin="15,20,15,0" Orientation="Vertical">
      <TextBox Name="StringTb" Style="{StaticResource MultiLineTextBox}" Margin="0,0,0,5"
               HorizontalContentAlignment="Center" FontFamily="/AMDtool;component/Resources/fonts/#Roboto"
               FontSize="14"/>
      <Label FontFamily="/AMDtool;component/Resources/fonts/#Roboto" FontSize="12">
        Modify if it clashes with your commands.
      </Label>
    </StackPanel>
  </Grid>
</Page>